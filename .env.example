# Google Calendar booking link (leave empty until Eze shares it)
NEXT_PUBLIC_CALENDAR_URL=

# Google Search Console: paste only the content value from the HTML meta tag.
# Example tag: <meta name="google-site-verification" content="abc123" />
# Set this in Vercel too, then redeploy. Leave empty until Google gives you the token.
GOOGLE_SITE_VERIFICATION=
